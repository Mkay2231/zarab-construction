# Contact form provider — choose one (see src/services/contactService.js):
#   netlify   → Netlify Forms (already set in netlify.toml for Netlify builds)
#   endpoint  → POST to VITE_CONTACT_ENDPOINT (e.g. /contact.php on cPanel hosting)
#   (empty)   → mock submission, nothing is sent (local development)
VITE_CONTACT_PROVIDER=

# Used only when VITE_CONTACT_PROVIDER=endpoint.
# For Namecheap / GoDaddy cPanel hosting with deploy/cpanel/contact.php: /contact.php
VITE_CONTACT_ENDPOINT=
